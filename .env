# ============================================================
# .env – Konfigurasi Environment
# Salin file ini ke .env dan sesuaikan nilainya
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=etl_db
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=etl_pass

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- API Sumber Data ---
API_BASE_URL=http://host.docker.internal:7001
API_LOG_ACTIVITY_ENDPOINT=/log_activity
API_PETUGAS_ENDPOINT=/petugas
# Timeout request ke API eksternal (detik)
API_TIMEOUT=30

# --- Jadwal (cron) ---
# Format: menit jam hari bulan hari-minggu
SCHEDULE_FETCH_INTERVAL_HOURS=1     # Ambil data setiap 1 jam
SCHEDULE_ETL_HOUR=2                  # Jalankan ETL penuh jam 2 pagi
SCHEDULE_ETL_MINUTE=0

# --- Flower Monitoring ---
FLOWER_USER=admin
FLOWER_PASS=admin123

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=/app/logs
